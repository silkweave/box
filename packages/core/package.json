{
  "name": "@silkweave/box-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Silkweave Box core: warehouse, auth, events and operations, linked from source with installed feature registration.",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "exports": {
    ".": {
      "@silkweave/box-source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    },
    "./testing": {
      "@silkweave/box-source": "./src/testing.ts",
      "types": "./build/testing.d.mts",
      "default": "./build/testing.mjs"
    },
    "./*": {
      "@silkweave/box-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "typecheck": "tsgo -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@silkweave/box-provider-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.1"
  }
}
