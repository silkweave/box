{
  "name": "silkweave-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "description": "A Silkweave Box consumer with the core server, web app and CLI.",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "prepare": "bun run box:json && bun run skills && bun run typegen --quiet",
    "setup": "bun --no-env-file --conditions=@silkweave/box-source apps/server/scripts/setup.ts",
    "box:json": "bun --no-env-file packages/cli/src/box-json.ts",
    "dev": "bun --no-env-file --conditions=@silkweave/box-source apps/server/src/builder/supervisor.ts --dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "clean": "turbo run clean",
    "start": "bun --no-env-file --conditions=@silkweave/box-source apps/server/src/builder/supervisor.ts",
    "start:prod": "bun --no-env-file --conditions=@silkweave/box-source apps/server/src/builder/supervisor.ts",
    "cli": "bun --no-env-file packages/cli/src/mcp-proxy.ts",
    "skills": "bun --no-env-file packages/cli/src/skills.ts",
    "skills:check": "bun --no-env-file packages/cli/src/skills.ts --check",
    "schema:check": "bun --no-env-file --conditions=@silkweave/box-source packages/core/scripts/schema-check.ts",
    "typegen": "bun --no-env-file --conditions=@silkweave/box-source apps/server/scripts/typegen.ts",
    "verify": "bun --no-env-file packages/cli/src/verify.ts",
    "auth:token": "bun --no-env-file --conditions=@silkweave/box-source apps/server/scripts/auth-token.ts",
    "auth:login": "bun --no-env-file --conditions=@silkweave/box-source apps/server/scripts/auth-login.ts",
    "auth:reveal": "bun --no-env-file --conditions=@silkweave/box-source apps/server/scripts/auth-reveal.ts",
    "db:snapshot": "bun --no-env-file --conditions=@silkweave/box-source apps/server/scripts/db-snapshot.ts snapshot",
    "db:restore": "bun --no-env-file --conditions=@silkweave/box-source apps/server/scripts/db-snapshot.ts restore",
    "db:seeds": "bun --no-env-file --conditions=@silkweave/box-source apps/server/scripts/db-snapshot.ts list",
    "db:backup": "bun --no-env-file --conditions=@silkweave/box-source apps/server/scripts/db-snapshot.ts backup",
    "box": "bun --no-env-file packages/cli/src/index.ts",
    "box:install": "bun --no-env-file packages/cli/src/box-install.ts",
    "test:core": "turbo run test --filter=@silkweave/box-core --output-logs=new-only",
    "test:server": "turbo run test --filter=@silkweave/box-server --output-logs=new-only",
    "test:packages": "turbo run test --filter=@silkweave/box-core --filter=@silkweave/box-server --output-logs=new-only",
    "test:cli": "bun --no-env-file test ./packages/cli/src/tests/*.test.ts",
    "test:web": "bun --no-env-file test ./apps/web/tests ./features/*/web ./packages/ui/src",
    "test:mobile": "bun --no-env-file packages/cli/src/mobile-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/client": "^2.4.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@openai/codex": "~0.158.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@silkweave/box-core": "workspace:*",
    "@silkweave/box-provider-kit": "workspace:*",
    "@silkweave/box-ui": "workspace:*",
    "@silkweave/core": "^7.1.1",
    "@silkweave/nestjs": "^7.1.1",
    "@silkweave/trpc": "^7.1.1",
    "@silkweave/typegen": "^7.1.1",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@trpc/client": "^11.26.0",
    "@trpc/server": "^11.26.0",
    "@workerdeck/client": "^4.4.0",
    "@workerdeck/core": "^4.4.0",
    "@workerdeck/protocol": "^4.4.0",
    "@workerdeck/server": "^4.4.0",
    "@workerdeck/ui": "^4.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "http-proxy-middleware": "^4.2.1",
    "kysely": "0.29.8",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.56.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shiki": "^4.6.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "rimraf": "^6.1.4",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxlint": "^1.93.0",
    "turbo": "^2.11.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "better-sqlite3"
  ]
}
