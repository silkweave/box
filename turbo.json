{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["features/**", "tsconfig.json", "box.json", "box.local.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // External engine subprocesses inherit their operating-system environment.
      "passThroughEnv": ["*"]
    }
  }
}
