{
  "$schema": "https://turborepo.com/schema.json",
  // AGENTS.md is maintained source; keep turbo from appending its agent block to it.
  "agentGuidance": false,
  // Negations drop gitignored output the mobile check rewrites (Dart tool state, build output, module
  // lockfiles) and local secrets: global globs ignore .gitignore, so these would miss every cache.
  "globalDependencies": [
    "features/**",
    "!features/**/.dart_tool/**",
    "!features/*/mobile/build/**",
    "!features/*/mobile/pubspec.lock",
    "!features/**/.dev.vars",
    "recipes/**",
    "tsconfig.json",
    "box.json",
    "box.local.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "typecheck": {
      "outputs": []
    },
    // Test results are cached by content hash, so `box verify` reruns a package's tests only when
    // its sources, a dependency's build (core for server), a global input (features/, box.json)
    // or its test config changed. `box verify --force` bypasses the cache.
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // External engine subprocesses inherit their operating-system environment.
      "passThroughEnv": ["*"]
    }
  }
}
