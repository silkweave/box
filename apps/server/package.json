{
  "name": "@silkweave/box-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Silkweave Box front door: NestJS serving REST + tRPC + MCP from one set of controllers over a DuckDB warehouse, plus the in-process agent host and the ops kernel.",
  "scripts": {
    "dev": "bun --no-env-file --conditions=@silkweave/box-source src/main.ts --dev",
    "build": "rimraf dist && cd ../.. && swc apps/server/src features -d apps/server/dist --config-file apps/server/.swcrc --ignore \"**/core/**,**/web/**,**/toolbar/**,**/*.test.ts\"",
    "start": "bun --no-env-file --conditions=@silkweave/box-source src/main.ts",
    "start:prod": "bun --no-env-file --conditions=@silkweave/box-source dist/apps/server/src/main.js",
    "typecheck": "tsgo -p tsconfig.json",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@openai/codex": "~0.158.0",
    "@silkweave/box-core": "workspace:*",
    "@silkweave/nestjs": "^5.2.2",
    "@silkweave/trpc": "^5.2.2",
    "@silkweave/typegen": "^5.2.2",
    "@trpc/server": "^11.19.0",
    "@workerdeck/core": "^3.4.0",
    "@workerdeck/protocol": "^3.4.0",
    "@workerdeck/server": "^3.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "http-proxy-middleware": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.1.3",
    "vitest": "^5.0.1"
  }
}
