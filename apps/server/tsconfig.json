{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": [
      "@silkweave/box-source"
    ],
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "noEmit": true,
    "types": [
      "node",
      "reflect-metadata"
    ],
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "../../features/*/server/**/*.ts"
  ]
}
