{
  // Root-run Bun scripts use source exports and emit Nest constructor metadata.
  // Each workspace owns its own typecheck configuration.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["@silkweave/box-source"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "include": ["apps/server/scripts/**/*.ts"]
}
