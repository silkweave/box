{
  "mcpServers": {
    "box": {
      "type": "http",
      "url": "http://localhost:8190/mcp",
      "headers": {
        "Authorization": "Bearer <access-token>"
      }
    },
    "warehouse": {
      "command": "uvx",
      "args": [
        "mcp-server-motherduck",
        "--db-path",
        "data/data.db",
        "--ephemeral-connections"
      ]
    }
  }
}
